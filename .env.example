# ==============================================================================
# GoldSea AI Chatbot — Environment Configuration Example
# ==============================================================================

# Application Environment (development | production)
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8080
APP_BASE_URL=http://localhost:8080

# Security Secret Key (Generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=generate_a_random_32_byte_hex_string_for_production

# Database Configuration (PostgreSQL in production; SQLite allowed in development)
# In Production: Render Postgres / Neon / Supabase URL
# Format: postgresql://username:password@hostname:5432/dbname
DATABASE_URL=sqlite:///data/goldsea.db
DATABASE_PATH=data/goldsea.db

# ------------------------------------------------------------------------------
# Email Service Configuration (Required in Production)
# Choose EITHER Option A (SMTP), Option B (Resend API), or Option C (Brevo API)
# ------------------------------------------------------------------------------

# Sender Address (used across all email providers)
EMAIL_FROM=noreply@yourdomain.com

# Option A: SMTP (e.g. Gmail with 16-character App Password, or SendGrid / Mailgun)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
SMTP_TLS=true

# Option B: Resend API (https://resend.com)
# RESEND_API_KEY=re_1234567890abcdef

# Option C: Brevo API (https://www.brevo.com - formerly Sendinblue)
# BREVO_API_KEY=xkeysib-1234567890abcdef

# Local / Test Email Backend (use 'console' for local dev and automated tests)
EMAIL_BACKEND=console

# ------------------------------------------------------------------------------
# LLM Model Providers
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free
